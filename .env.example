# Rupandehi Property Hub - Production Environment Variables
# Copy to .env.local for local development or deploy in Vercel / Railway / VPS environment

# 1. Database Connection (PostgreSQL 15+ / Supabase / Neon)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. Supabase Integration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Nepal SMS Gateway (Phone OTP Authentication)
# Providers: Sparrow SMS (https://sparrowsms.com) or Aakash SMS (https://aakashsms.com)
SPARROW_SMS_TOKEN="your_sparrow_sms_token_here"
SPARROW_SMS_IDENTITY="RupandehiPH"

# 4. Media Storage (Cloudinary / AWS S3 for Property Photos & Lalpurja Docs)
CLOUDINARY_CLOUD_NAME="rupandehipropertyhub"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"

# 5. Application URLs & Security
NEXT_PUBLIC_APP_URL="http://localhost:5173"
JWT_SECRET="rupandehi_property_hub_secure_jwt_token_2026_secret"
NODE_ENV="production"
